&clockinit
    daynew = 1
    yearnew = 2000
/

&calendar
    include_fleapyear = .true.
/

&paths
    meshpath = '/p/project/chhb19/jstreffi/input/fesom2//core2/'
    climatedatapath = '/p/project/chhb19/jstreffi/input/fesom2//hydrography/'
    resultpath = '<TEST_DIR>/run/awicm3//awicm3-v3.4-TCO95L91-CORE2_initial/run_20000101-20000101/work/'
/

&timestep
    step_per_day = 48
    run_length = 1
    run_length_unit = 'd'
/

&restart_log
    restart_length = 1
    restart_length_unit = 'd'
/

&inout
    restartflag = 'last'
    output_length = 1
    output_length_unit = 'd'
/

&run_config
    lwiso = .false.
/

&icebergs
    use_icebergs = .false.
    use_icesheet_coupling = .false.
    steps_per_ib_step = 8
/

&ale_def
    which_ale = 'zstar'
/
