&master_nml
    lrestart = .false.
    read_restart_namelists = .true.
/

&master_time_control_nml
    calendar = 'proleptic gregorian'
    experimentstartdate = '1850-01-01T00:00:00'
    restarttimeintval = 'P01D'
    checkpointtimeintval = 'P01D'
    experimentstopdate = '1850-01-02T00:00:00'
/

&time_nml
    is_relative_time = .true.
/

&master_model_nml
    model_name = 'atmo'
    model_namelist_filename = 'NAMELIST_atm'
    model_type = 1
/

&jsb_control_nml
    is_standalone = .false.
    restart_jsbach = .false.
    debug_level = 0
    timer_level = 0
/

&jsb_model_nml
    model_id = 1
    model_name = 'JSBACH'
    model_shortname = 'jsb'
    model_description = 'JSBACH land surface model'
    model_namelist_filename = 'NAMELIST_lnd'
/
