&modelname
    runid = 'fesom'
/

&timestep
    step_per_day = 48
    run_length = 1
    run_length_unit = 'd'
/

&clockinit
    timenew = 0.0
    daynew = 1
    yearnew = 1850
/

&paths
    meshpath = '/pool/data/AWICM//FESOM2/MESHES_FESOM2.1//core2/'
    climatedatapath = '/pool/data/AWICM//FESOM2/INITIAL/phc3.0/'
    resultpath = '<TEST_DIR>/run/icon-fesom//icon-2025.10-fesom-pictl-r2b4-core2/run_18500101-18500101/work/'
/

&restart_log
    restart_length = 1
    restart_length_unit = 'd'
    raw_restart_length = 1
    raw_restart_length_unit = 'y'
    bin_restart_length = 1
    bin_restart_length_unit = 'y'
    logfile_outfreq = 1
/

&ale_def
    which_ale = 'zstar'
    use_partial_cell = .true.
/

&geometry
    cartesian = .false.
    fplane = .false.
    cyclic_length = 360
    rotated_grid = .true.
    force_rotation = .true.
    alphaeuler = 50.0
    betaeuler = 15.0
    gammaeuler = -90.0
/

&calendar
    include_fleapyear = .true.
/

&run_config
    use_ice = .true.
    use_cavity = .false.
    use_cavity_partial_cell = .false.
    use_floatice = .false.
    use_sw_pene = .true.
    flag_debug = .false.
    use_transit = .false.
    lwiso = .false.
/

&machine
    n_levels = 2
    n_part = 5, 128
/

&icebergs
    use_icesheet_coupling = .false.
    ib_num = 1
    use_icebergs = .false.
    steps_per_ib_step = 8
    ib_async_mode = 0
/

&inout
    restartflag = 'last'
    output_length = 1
    output_length_unit = 'd'
    restart_length = 1
/
