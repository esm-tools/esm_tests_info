&forcing_exchange_coeff
    ce_atm_oce = 0.00175
    ch_atm_oce = 0.00175
    cd_atm_oce = 0.001
    ce_atm_ice = 0.00175
    ch_atm_ice = 0.00175
    cd_atm_ice = 0.0012
    swind = 0.0
/

&forcing_bulk
    aomip_drag_coeff = .false.
    ncar_bulk_formulae = .true.
    ncar_bulk_z_wind = 10.0
    ncar_bulk_z_tair = 10.0
    ncar_bulk_z_shum = 10.0
/

&land_ice
    use_landice_water = .false.
    landice_start_mon = 5
    landice_end_mon = 10
    fwf_path = './mesh/'
/

&age_tracer
    use_age_tracer = .false.
    use_age_mask = .false.
    age_tracer_path = './mesh/'
    age_start_year = 2000
/

&nam_sbc
    nm_xwind_file = 'FORCING/CORE2/u_10.'
    nm_ywind_file = 'FORCING/CORE2/v_10.'
    nm_humi_file = 'FORCING/CORE2/q_10.'
    nm_qsr_file = 'FORCING/CORE2/ncar_rad.'
    nm_qlw_file = 'FORCING/CORE2/ncar_rad.'
    nm_tair_file = 'FORCING/CORE2/t_10.'
    nm_prec_file = 'FORCING/CORE2/ncar_precip.'
    nm_snow_file = 'FORCING/CORE2/ncar_precip.'
    nm_mslp_file = 'FORCING/CORE2/slp.'
    nm_xwind_var = 'U_10_MOD'
    nm_ywind_var = 'V_10_MOD'
    nm_humi_var = 'Q_10_MOD'
    nm_qsr_var = 'SWDN_MOD'
    nm_qlw_var = 'LWDN_MOD'
    nm_tair_var = 'T_10_MOD'
    nm_prec_var = 'RAIN'
    nm_snow_var = 'SNOW'
    nm_mslp_var = 'SLP'
    nm_nc_iyear = 1948
    nm_nc_imm = 1
    nm_nc_idd = 1
    nm_nc_freq = 1
    nm_nc_tmid = 1
    y_perpetual = .false.
    l_xwind = .true.
    l_ywind = .true.
    l_humi = .true.
    l_qsr = .true.
    l_qlw = .true.
    l_tair = .true.
    l_prec = .true.
    l_mslp = .false.
    l_cloud = .false.
    l_snow = .true.
    runoff_data_source = 'CORE2'
    nm_runoff_file = 'FORCING/CORE2/runoff.nc'
    sss_data_source = 'CORE2'
    nm_sss_data_file = 'FORCING/CORE2/PHC2_salx.nc'
    chl_data_source = 'None'
    nm_chl_data_file = 'FORCING/Sweeney/Sweeney_2005.nc'
    chl_const = 0.1
    use_runoff_mapper = .false.
    runoff_basins_file = 'FORCING/CORE2/runoff_maps_regular.nc'
    runoff_radius = 500000.0
/
