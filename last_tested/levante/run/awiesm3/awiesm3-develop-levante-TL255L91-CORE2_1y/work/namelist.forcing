    nm_ywind_var = 'vas'
    nm_xstre_var = 'uas'
    nm_ystre_var = 'vas'
    nm_humi_var = 'huss'
    nm_qsr_var = 'rsds'
    nm_qlw_var = 'rlds'
    nm_tair_var = 'tas'
    nm_prec_var = 'prra'
    nm_snow_var = 'prsn'
    nm_mslp_var = 'psl'
    nm_nc_iyear = 1900
    nm_nc_imm = 1
    nm_nc_idd = 1
    nm_nc_freq = 1
    nm_nc_tmid = 0
