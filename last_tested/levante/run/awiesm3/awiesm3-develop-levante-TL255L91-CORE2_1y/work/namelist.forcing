&forcing_exchange_coeff
    ce_atm_oce = 0.00175
    ch_atm_oce = 0.00175
    cd_atm_oce = 0.001
    ce_atm_ice = 0.00175
    ch_atm_ice = 0.00175
    cd_atm_ice = 0.0012
    swind = 0.0
/

&forcing_bulk
    aomip_drag_coeff = .false.
    ncar_bulk_formulae = .true.
    ncar_bulk_z_wind = 10.0
    ncar_bulk_z_tair = 10.0
    ncar_bulk_z_shum = 10.0
/

&land_ice
    use_landice_water = .false.
    landice_start_mon = 5
    landice_end_mon = 10
    fwf_path = '<add path>'
/

&age_tracer
    use_age_tracer = .false.
    use_age_mask = .false.
    age_tracer_path = '<add path>'
    age_start_year = 2000
/

&nam_sbc
